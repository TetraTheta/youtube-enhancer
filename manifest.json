{
  "manifest_version": 3,
  "name": "YouTube Enhancer",
  "version": "0.1.0",
  "description": "Set YouTube playback quality, volume, autoplay, Shorts, and audio tracks.",
  "browser_specific_settings": {
    "gecko": {
      "id": "{bf2c263d-3b5a-4bcd-b25f-1f2d26dc3de6}",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "permissions": ["storage", "downloads"],
  "host_permissions": ["https://www.youtube.com/*", "https://www.youtube-nocookie.com/*"],
  "action": {
    "default_title": "YouTube Enhancer 설정"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "src/background.js",
    "scripts": ["src/background.js"]
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*", "https://www.youtube-nocookie.com/embed/*"],
      "all_frames": true,
      "run_at": "document_start",
      "world": "MAIN",
      "js": ["src/player-logic.js", "src/player.js"]
    },
    {
      "matches": ["https://www.youtube.com/*", "https://www.youtube-nocookie.com/embed/*"],
      "all_frames": true,
      "run_at": "document_start",
      "js": ["src/defaults.js", "src/settings.js", "src/screenshot.js"]
    }
  ]
}
